generator kysely {
    provider = "prisma-kysely"

    output       = "../../src/db"
    fileName     = "types.ts"
    enumFileName = "enums.ts"
}

datasource db {
    provider = "sqlite"
    url      = "file:../../db.sqlite"
}

model ipban {
    ip String @id
}

model account {
    id Int @id @default(autoincrement())

    username String @unique
    password String

    registration_ip   String?
    registration_date DateTime @default(now())

    muted_until  DateTime?
    banned_until DateTime?

    staffmodlevel Int     @default(0)
    // custom (2026-11-06) - helped test the server before launch. Shows a bronze emblem beside
    // the name in chat (ChatCrown, crown 7) and nothing else: it grants no powers and is not a
    // staffmodlevel, because every rank check in the engine reads "at least" and a veteran must
    // not pass any of them.
    //
    // ON THE ACCOUNT RATHER THAN IN THE SAVE, which is the whole reason it is here: the launch
    // wipe moves character saves away and keeps account rows, so a perm varp would have thrown
    // the rank away on the day it started to mean something.
    veteran       Int     @default(0)

    // custom (2026-11-11) - the Helper rank: answers other players' questions, and carries no
    // powers whatsoever. Shows a blue roundel beside the name in chat (ChatCrown, crown 8). A flag
    // rather than a staffmodlevel for the same reason veteran is one, and more sharply: the whole
    // value of this rank is that there is nothing attached to it to abuse.
    helper        Int     @default(0)
    members       Boolean @default(false)

    // custom (2026-11-15) - the experience rate this account chose: 1, 5 or 10. A MIRROR of the
    // save's `xp_rate` varp, written by the login server on every logout beside the hiscore rows it
    // derives the same way. Player.xpRate() is still the only thing that decides what a player
    // earns; this is here so the website can filter a leaderboard by mode without reading a save,
    // which it has no way to do.
    //
    // Beside members/veteran/helper because it is a fact about the ACCOUNT rather than the
    // character, and because the board query already joins this table for the username. 1 is what
    // xpRate() returns for a varp never written, so the default matches the engine's own answer.
    //
    // An ironman mode, if it comes, is a separate column. Not this one widened.
    xp_rate       Int     @default(1)
}

// custom (2026-11-02) - A SAVED LOGIN ON ONE COMPUTER. The client used to keep the player's own
// password in ~/.deathplateau/profiles.properties, encrypted with a key any program on that
// machine can read; the file's own header said to treat a leak as a leaked password. This is the
// replacement: the server issues a token, the client stores that instead, and a leak costs
// something that can be cancelled.
//
// One row per computer, so one can be dropped without touching the others, and so a player can
// be told what is signed in where. Deleting the row is the revocation - there is no flag to get
// out of step with.
model account_token {
    id Int @id @default(autoincrement())

    account_id Int

    // sha256 of the token, hex. A password needs bcrypt because people choose it; a token is 103
    // bits of randomness, so there is nothing to brute-force, and a plain digest can be looked up
    // by value in one indexed query instead of compared against every row.
    token_hash String @unique

    created   DateTime @default(now())
    last_used DateTime @default(now())
    expires   DateTime

    // What signlink.uid said, kept so a list of saved logins can say which computer each is.
    uid        Int?
    created_ip String?

    @@index([account_id])
}

model account_login {
    account_id Int
    profile    String

    logged_in  Int       @default(0)
    login_time DateTime?

    logged_out  Int       @default(0)
    logout_time DateTime?

    @@id([profile, account_id])
}

/// Which items an account has in its collection log, one row per item. The hiscore table
/// carries how far along somebody is as a single number, because that can be ranked; which items
/// is a set 803 wide and belongs in rows.
model collection_log {
    profile    String @default("main")
    account_id Int
    obj        Int
    count      Int

    @@id([profile, account_id, obj])
    @@index([profile, account_id])
}

model hiscore {
    account_id Int
    profile    String @default("main")
    type       Int

    level Int
    value Int
    date  DateTime @default(now()) @updatedAt

    @@id([profile, type, account_id])
}

model hiscore_large {
    account_id Int
    profile    String @default("main")
    type       Int

    level Int
    value BigInt
    date  DateTime @default(now()) @updatedAt

    @@id([profile, type, account_id])
}

model friendlist {
    account_id      Int
    friend_username String
    profile         String @default("main")

    created DateTime @default(now())

    @@id([profile, account_id, friend_username])
}

model ignorelist {
    account_id Int
    value      String
    profile    String @default("main")

    created DateTime @default(now())

    @@id([profile, account_id, value])
}

model session {
    uuid String @id

    account_id Int
    profile    String
    world      Int
    timestamp  DateTime

    uid Int
    ip  String?
}

model session_log {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    coord      Int
    event      String
    event_type Int    @default(-1)
}

model session_wealth {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    coord      Int
    event_type Int @default(-1)

    account_items String
    account_value Int

    recipient_session String?
    recipient_items   String?
    recipient_value   Int?
}

model public_chat {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    coord   Int
    message String
}

model private_chat {
    id Int @id @default(autoincrement())

    account_id Int
    profile    String

    timestamp     DateTime
    coord         Int
    to_account_id Int
    message       String
}

model clan_chat {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    coord   Int
    owner   String
    channel String
    message String

    @@index([session_uuid])
}

model report {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    coord    Int
    offender String
    reason   Int
}

// How much of a session came from a person at a keyboard. One row as each session ends.
//
// The client reports where the cursor went, where it was clicked, whether the camera was turned
// and whether the window kept focus. A bot driving the real client produces all of it; a bot
// speaking the protocol straight at the server produces none, because nothing is moving a mouse to
// report. A high user_actions against a near-zero sum of the rest is the signal - neither half
// means anything alone, since somebody standing in a bank moves no mouse either.
//
// Counted for everybody and costing five integers a player. input_report below is the FULL capture,
// which is off unless somebody turns it on for a suspect and costs about a megabyte per
// player-hour. This table is the triage that says who is worth that.
model session_input {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    user_actions  Int
    mouse_moves   Int
    mouse_clicks  Int
    camera_moves  Int
    focus_changes Int

    @@index([session_uuid])
}

model input_report {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    data Bytes
}
