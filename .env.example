# This is a comment!
# Uncomment lines if you want to change them from their defaults

## web server
# WEB_PORT=80
# WEB_CORS=false
# WEB_SOCKET_TOKEN_PROTECTION=false

## management server
# WEB_MANAGEMENT_PORT=8898
## loopback only by default - /prometheus and /reboot are not for the internet
# WEB_MANAGEMENT_HOST=127.0.0.1

## game server
# NODE_ID=10
# NODE_PORT=43594
# NODE_MEMBERS=true
# NODE_AUTO_SUBSCRIBE_MEMBERS=true
# NODE_XPRATE=1
# NODE_PRODUCTION=false
## a staff-only world (the dev world): refuse logins below this staff level - 3 = administrator. 0 = everyone
# NODE_MIN_STAFF_LEVEL=0
# NODE_KILLTIMER=50
# NODE_DEBUG=true
# NODE_DEBUG_PROFILE=false
# NODE_DEBUG_SOCKET=false
# NODE_STAFF=pazaz
# NODE_CLIENT_ROUTEFINDER=true
# NODE_SOCKET_TIMEOUT=true
# NODE_WALKTRIGGER_SETTING=0
# NODE_PROFILE=main
## server-side bot players in the Wilderness (src/engine/bot) - the dev world only, never live
# NODE_BOTS=false
## optional JSON of overrides (counts, hotspots, reaction times, death drop...) - see src/engine/bot/BotConfig.ts
# NODE_BOTS_CONFIG=data/config/bots.json
## counts, overriding the file, spread over the low/mid/high/max brackets (-1 = the file / the default: 6 roamers 2/2/1/1, 4 PKers 1/1/1/1)
# NODE_BOTS_ROAMERS=-1
# NODE_BOTS_PKERS=-1
## what bots pray in a fight: smite (52 Prayer, drains the target's prayer), protect (protection prayers
## against the attacker's style) or none - empty = the file / the default, smite
# NODE_BOTS_PRAYER=
## every N ticks, one log line per bot (what it is doing, where it is heading, run energy) - 0 = off
# NODE_BOTS_TRACE=0
## the fuzzing bots (src/engine/bot/BotFuzzer.ts): they wander and then click everything in reach, and
## the watchers say when something is wrong without knowing what the content meant. DEV WORLDS ONLY -
## it also refuses unless NODE_PRODUCTION=false and no non-staff player is in the world. ::bot fuzz
# NODE_BOTS_FUZZ=false
# NODE_BOTS_FUZZ_COUNT=4
## 0 = a fresh seed each boot, printed on startup so a finding can be replayed with it
# NODE_BOTS_FUZZ_SEED=0
## where they start, "x,z,level" - empty = Lumbridge
# NODE_BOTS_FUZZ_AT=
# NODE_BOTS_FUZZ_FILE=data/fuzz-findings.jsonl
## the script fault reporter (src/engine/script/ScriptFaults.ts): every RuneScript error, collected by
## signature with a count and a backtrace, instead of scrolling past in journalctl. ::faults reads it.
## Safe on live - off it costs one boolean read per script error, and it never throws.
# NODE_SCRIPT_FAULTS=false
# NODE_SCRIPT_FAULTS_FILE=data/faults.jsonl
## a Discord webhook posted to once per NEW signature, at most 4 a minute. THIS IS A SECRET: anyone
## holding it can post to the channel. Keep it here, never in a commit - the engine never prints it.
# NODE_SCRIPT_FAULTS_WEBHOOK=

## THE PUBLIC MARKET FEED (src/server/market/MarketFeed.ts). When somebody lists an item on the
## trading post, a card for it is posted to a Discord channel - the card is drawn by the server out
## of its own cache, so it uses the real item icon and the real game font. Off entirely unless the
## webhook below is set.
##
## THIS IS A SECRET, like the one above: anyone holding it can post to that channel as the server.
## Keep it here, never in a commit. The engine never prints it - only whether there is one. Make one
## in Discord under Channel settings -> Integrations -> Webhooks.
# MARKET_FEED_WEBHOOK=
## a listing worth less than this many coins is not posted at all. The buyout where there is one,
## and the lot's shop value where there is not, so an offers-only listing is still judged on
## something. ZERO, the default since 19 November 2026, posts everything - including a lot worth
## nothing, which is what an offers-only listing of a cheap item comes to. Raise it once there is
## an economy to keep the bronze daggers out of.
# MARKET_FEED_MIN=0
## milliseconds between cards. The queue holds the rest and drops the CHEAPEST when it is full, so a
## busy evening loses the bronze daggers rather than the whale. Clamped to 1000 at the lowest.
# MARKET_FEED_EVERY=15000
## where tools/models/ObjIconFiles.java wrote the item icons. On the live box that is the website's
## copy: /opt/deathplateau/web/public/icons. Unset, and the cards still draw with an empty slot.
# MARKET_CARD_ICONS=

## the 23 skill icons, beside the item icons above - on the live box the website's copy:
## /opt/deathplateau/web/public/skills. What a 99 or an experience milestone puts on its card.
## Unset, and those cards come out without a picture rather than not at all.
# CARD_SKILL_ICONS=

## THE BROADCAST FEED: the world's announcements as cards, in a Discord channel of their own.
## Milestones (99s, total levels, max capes, server firsts) and news (rare drops, pets, the Fire
## cape). NOT yells and NOT staff announcements - BroadcastFeed withholds both, twice over.
## A webhook url is a password: keep it here and nowhere else. Unset, and the feed is simply off.
# BROADCAST_FEED_WEBHOOK=
## milliseconds between cards. Lower than the market's 15s because these are rarer and more worth
## reading, and because milestones arrive in bursts. Clamped to 1000 at the lowest.
# BROADCAST_FEED_EVERY=5000
## which of the build's triggers have ever run (src/engine/script/ScriptCoverage.ts). ::coverage reads
## it, ::coverage write dumps the never-reached list - which is a to-do list nobody can write by hand.
## Counted per process: it starts empty at every reboot. Off it is one boolean read per script run.
# NODE_SCRIPT_COVERAGE=false
# NODE_SCRIPT_COVERAGE_FILE=data/coverage.txt
# NODE_MAX_PLAYERS=2047
# NODE_MAX_NPCS=8191
# NODE_DEBUGPROC_CHAR=~
## open sockets in total and per address (0 = no limit)
# NODE_MAX_SOCKETS=2048
# NODE_MAX_SOCKETS_PER_IP=16
## ticks with no real input before a live world logs a player out (1000 = 10 minutes); three times
## that and it does not wait for combat to end. 0 = off. Administrators (3+) are exempt.
# NODE_IDLE_LOGOUT_TICKS=1000
## behind a tunnel or VPS proxy that sends PROXY protocol: its address(es), comma separated
## (CIDRs work, e.g. 10.8.0.0/24), so players keep their own addresses. Connections from these
## are read for the header - one without any (Tailscale in userspace mode forwards from 127.0.0.1)
## keeps its own address; everyone else connects as normal. playit.gg's agent connects from a random
## 127.x.x.x address, not 127.0.0.1, so behind playit use the whole loopback range: 127.0.0.0/8
# PROXY_PROTOCOL_FROM=
## the login RSA key's private half - make it with `npm run rsa`, never commit it
# LOGIN_RSA_KEY_PATH=data/config/login-rsa.pem

## login server
# LOGIN_SERVER=false
# LOGIN_HOST=localhost
# LOGIN_PORT=43500

## friend server
# FRIEND_SERVER=false
# FRIEND_HOST=localhost
# FRIEND_PORT=45099

## logger server
# Records deaths, trades, drops and reports into session_log / session_wealth. With this false
# nothing is written at all, and there is no way to find out afterwards what somebody lost.
#
# LOGGER_SERVER is the switch on the GAME side. It makes the world send events to a logger
# process, which is a separate program - `npm run logger` - that has to be running for anything to
# reach the database. EASY_STARTUP=true starts one in-process instead; do not do both.
#
# Events carry a session uuid, and the uuid -> account mapping is written by the LOGIN server. Run
# without LOGIN_SERVER and deaths are still logged in full, just not attributable to a name -
# `account.ts deaths` falls back to listing them by time.
# LOGGER_SERVER=false
# LOGGER_HOST=localhost
# LOGGER_PORT=43501

## internal servers (login, friend, logger)
## what they listen on - loopback unless a world runs on another machine
# INTERNAL_BIND_HOST=127.0.0.1
## shared by every process; required if INTERNAL_BIND_HOST is not loopback. e.g. `openssl rand -hex 32`
# INTERNAL_SECRET=

## database
# DB_BACKEND=sqlite
# DATABASE_URL=mysql://root:password@localhost:3306/lostcity
# DB_HOST=localhost
# DB_NAME=lostcity
# DB_USER=root
# DB_PASS=password
# KYSELY_VERBOSE=false

## development
# BUILD_JAVA_PATH=java
# BUILD_STARTUP=true
# BUILD_STARTUP_UPDATE=true
# BUILD_VERIFY=true
## BUILD_VERIFY checks the pack files - every config has an id line, every id line has a config.
## BUILD_VERIFY_CACHE checks each packed archive against the ORIGINAL 377 cache, byte for byte.
## It is off by default because a repo with custom content cannot pass it: this one has added locs,
## npcs, objs, seqs, spotanims, varbits, varps and interfaces, and 8 of the 10 archives no longer
## match. Turn it on only on a repo that is meant to reproduce stock 377 exactly.
# BUILD_VERIFY_CACHE=false
# BUILD_VERIFY_FOLDER=true
# BUILD_VERIFY_PACK=true
# BUILD_SRC_DIR=data/src
